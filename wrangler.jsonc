{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duck-bear-hq",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-10",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duck-bear-hq-db",
      "database_id": "05f3e993-e41a-4d0e-8166-bcd04ae235f9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "duck-bear-hq-media"
    }
  ]
}
